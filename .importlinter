[importlinter]
root_packages =
    app

[importlinter:contract:contract-a-canonical-persistence-no-upward]
name = Contract A: Canonical persistence core cannot depend upward or into transport
type = forbidden
source_modules =
    app.persistence.history
    app.persistence.database
    app.persistence.migrations
    app.persistence.deletion_operations
forbidden_modules =
    app.analytics
    app.services
    app.api
    app.provisioning
    app.transport

[importlinter:contract:contract-b-canonical-history-gateway]
name = Contract B: Only approved gateway modules may import app.persistence.history
type = forbidden
source_modules =
    app.analytics
forbidden_modules =
    app.persistence.history
ignore_imports =
    app.analytics.canonical_source -> app.persistence.history
    app.analytics.rebuild -> app.persistence.history
allow_indirect_imports = True

