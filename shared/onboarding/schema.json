          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "account_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "consent_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
