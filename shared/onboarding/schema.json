          "properties": {
            "installation": {
              "enum": [
                "unknown",
                "missing",
                "verified"
              ]
            },
            "enrollment": {
              "enum": [
                "unknown",
                "missing",
                "verified"
              ]
            },
            "pairing": {
              "enum": [
                "unknown",
                "missing",
                "verified"
              ]
            },
            "activation": {
              "enum": [
                "unknown",
                "missing",
                "verified"
              ]
            },
            "analysis": {
              "enum": [
                "unknown",
                "missing",
                "verified"
              ]
            }
          }
        },
        "pending_operation": {
          "oneOf": [
            {
              "type": "null"
