{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ofca:local-onboarding:v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "kind",
        "journey_id",
        "source",
        "epoch",
        "revision",
        "account_generation",
        "consent_generation",
        "facts",
        "pending_operation",
        "reason"
      ],
      "properties": {
        "profile": {
          "const": "local-onboarding-state.v1"
        },
        "kind": {
          "enum": [
            "snapshot",
            "event"
          ]
        },
        "journey_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source": {
          "const": "brain"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "account_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "consent_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "facts": {
          "type": "object",
