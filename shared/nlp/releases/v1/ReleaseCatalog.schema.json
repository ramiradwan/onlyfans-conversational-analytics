{
  "$defs": {
    "AdapterIdentity": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Adapter Version",
          "type": "string"
        },
        "adapter_build_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Build Sha256",
          "type": "string"
        },
        "abi": {
          "const": "nlp-adapter.v1",
          "default": "nlp-adapter.v1",
          "title": "Abi",
          "type": "string"
        },
        "architecture": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Architecture",
          "type": "string"
        },
        "artifact_format": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Artifact Format",
          "type": "string"
        },
        "tokenizer_format": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Tokenizer Format",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "adapter_build_sha256",
        "architecture",
        "artifact_format",
        "tokenizer_format"
      ],
      "title": "AdapterIdentity",
      "type": "object"
    },
    "EngineIdentity": {
      "additionalProperties": false,
      "properties": {
        "package_name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Package Name",
          "type": "string"
        },
        "package_family": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Package Family",
          "type": "string"
        },
        "core_package_name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Core Package Name",
          "type": "string"
        },
        "core_package_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Core Package Version",
          "type": "string"
        },
        "publisher": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "package_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Package Version",
          "type": "string"
        },
        "related_set_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Related Set Id",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Engine Version",
          "type": "string"
        },
        "platform": {
          "const": "windows-x64",
          "title": "Platform",
          "type": "string"
        },
        "worker_protocol": {
          "const": "nlp-worker.v2",
          "default": "nlp-worker.v2",
          "title": "Worker Protocol",
          "type": "string"
        },
        "engine_build_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Build Sha256",
          "type": "string"
        }
      },
      "required": [
        "package_name",
        "package_family",
        "core_package_name",
        "core_package_version",
        "publisher",
        "package_version",
        "related_set_id",
        "engine_version",
        "platform",
        "engine_build_sha256"
      ],
      "title": "EngineIdentity",
      "type": "object"
    },
    "ProfileCompatibility": {
      "additionalProperties": false,
      "description": "An exact compatibility declaration, with no metadata authentication claim.",
      "properties": {
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "compatible_engines": {
          "items": {
            "$ref": "#/$defs/EngineIdentity"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Compatible Engines",
          "type": "array"
        },
        "adapters": {
          "items": {
            "$ref": "#/$defs/AdapterIdentity"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Adapters",
          "type": "array"
        }
      },
      "required": [
        "profile_sha256",
        "compatible_engines",
        "adapters"
      ],
      "title": "ProfileCompatibility",
      "type": "object"
    },
    "ReleaseEntry": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Profile Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Revision",
          "type": "string"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "compatibility": {
          "$ref": "#/$defs/ProfileCompatibility"
        }
      },
      "required": [
        "profile_id",
        "revision",
        "profile_sha256",
        "compatibility"
      ],
      "title": "ReleaseEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "nlp-release-catalog.v1",
      "default": "nlp-release-catalog.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "issued_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Issued At",
      "type": "integer"
    },
    "expires_at": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Expires At",
      "type": "integer"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ReleaseEntry"
      },
      "maxItems": 32,
      "title": "Profiles",
      "type": "array"
    },
    "withdrawals": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 4096,
      "title": "Withdrawals",
      "type": "array"
    }
  },
  "required": [
    "sequence",
    "issued_at",
    "expires_at",
    "profiles",
    "withdrawals"
  ],
  "title": "ReleaseCatalog",
  "type": "object"
}
