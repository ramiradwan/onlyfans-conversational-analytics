{
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "nlp-worker.v2",
      "default": "nlp-worker.v2",
      "title": "Protocol",
      "type": "string"
    },
    "operation": {
      "enum": [
        "cancel",
        "unload"
      ],
      "title": "Operation",
      "type": "string"
    },
    "request_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "component_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Component Sha256",
      "type": "string"
    },
    "target_request_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Request Id"
    },
    "outcome": {
      "enum": [
        "completed",
        "busy",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "health": {
      "enum": [
        "ready",
        "unloaded",
        "failed"
      ],
      "title": "Health",
      "type": "string"
    }
  },
  "required": [
    "operation",
    "request_id",
    "profile_sha256",
    "component_sha256",
    "outcome",
    "health"
  ],
  "title": "LifecycleResult",
  "type": "object"
}
