{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ofca-msix-package-profile/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "purpose", "distribution", "identity", "application_version", "release_sequence", "minimum_os_version", "maximum_os_version_tested", "webview2_minimum_version", "app_installer_uri"],
  "properties": {
    "schema": {"const": "ofca-msix-package-profile/v1"},
    "purpose": {"enum": ["production", "qualification"]},
    "distribution": {"enum": ["direct-appinstaller", "microsoft-store"]},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "publisher", "publisher_display_name", "application_id", "architecture"],
      "properties": {
        "name": {"type": "string", "minLength": 3, "maxLength": 50, "pattern": "^[A-Za-z0-9.-]+$", "default": "Dipsy.OnlyFansConversationalAnalytics"},
        "publisher": {"type": "string", "minLength": 3, "maxLength": 8192, "pattern": "^CN=.+$"},
        "publisher_display_name": {"type": "string", "minLength": 1, "maxLength": 256, "default": "Dipsy"},
        "application_id": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9]*$", "default": "Bridge"},
        "architecture": {"const": "x64"}
      }
    },
    "application_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.+-]+)?$", "maxLength": 64},
    "release_sequence": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "minimum_os_version": {"$ref": "#/$defs/version"},
    "maximum_os_version_tested": {"$ref": "#/$defs/version"},
    "webview2_minimum_version": {"$ref": "#/$defs/version"},
    "app_installer_uri": {"type": ["string", "null"], "maxLength": 2048}
  },
  "$defs": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 23}}
}
