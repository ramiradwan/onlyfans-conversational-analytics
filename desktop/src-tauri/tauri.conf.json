{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conversation Analytics",
  "version": "0.7.5",
  "identifier": "org.conversation-analytics.bridge",
  "build": { "frontendDist": "../shell" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["desktop", "window-frame"]
    }
  },
  "bundle": { "active": false, "icon": ["../../packaging/windows/conversation-analytics.ico"] }
}
