{
  "name": "onlyfans-conversational-analytics-agent",
  "private": true,
  "version": "2.0.3",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs capture protocol transport runtime ui popup.js setup.js options.js",
    "build": "node build.mjs",
    "audit": "node build.mjs --audit",
    "build:snow": "node crypto/snow/build.mjs",
    "verify:snow": "node crypto/snow/build.mjs --check",
    "verify:customer-release": "node qualification/customer-release-gate.mjs",
    "package:chrome": "npm run verify:customer-release && node build.mjs --package",
    "audit:chrome": "node build.mjs --audit-package",
    "test:browser:release": "playwright test --config qualification/playwright.config.mjs",
    "test:browser:signer-recovery": "node qualification/signer-worker-recovery.mjs",
    "test:browser:pairing-storage": "node qualification/pairing-storage-browser.mjs",
    "verify:release": "node qualification/verify-release.mjs",
    "legal:evidence": "node ../tools/legal-evidence/generate-activation-bundle.mjs",
    "qualify:snapshot": "node --expose-gc qualification/snapshot-100k.mjs",
    "qualify:snapshot:ci": "node --expose-gc qualification/snapshot-100k.mjs --messages=10000",
    "test:browser:surfaces": "playwright test --config qualification/surface-playwright.config.mjs"
  },
  "dependencies": {
    "local-authenticated-read-connector": "file:vendor/local-authenticated-read-connector-0.2.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "dependency-cruiser": "18.3.1",
    "esbuild": "0.25.6",
    "fflate": "0.8.3"
  },
  "description": "Conversation Analytics provides a consent-gated seven-day activity preview and connects creator-authorized analytics to an on-device service.",
  "main": "background.js",
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
