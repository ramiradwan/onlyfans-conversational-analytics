{
  "manifest_version": 3,
  "name": "Conversation Analytics",
  "description": "Shows seven-day local OnlyFans creator activity metrics and, with consent, connects analytics to a service on this computer.",
  "version": "2.0.1",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "webRequest"
  ],
  "optional_host_permissions": [
    "https://onlyfans.com/*",
    "http://bridge.localhost:17871/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Conversation Analytics",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "http://bridge.localhost:17871/*"
    ]
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://bridge.localhost:17871 ws://bridge.localhost:17871;"
  }
}
