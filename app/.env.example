# Development-only source checkout configuration.
# Production runtime.env is generated by app.core.first_run in the per-user data directory.
ENVIRONMENT=development
WEBSOCKET_AUTH_MODE=development_stub
WEBSOCKET_BIND_HOST=127.0.0.1

# Development persistence is explicitly disposable.
CANONICAL_PERSISTENCE_BACKEND=memory

EXTENSION_ID=

NLP_MODEL_PATH=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

BROADCAST_URL=memory://
