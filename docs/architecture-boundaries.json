  "rules": [
    {
      "id": "rule-canonical-persistence-no-upward",
      "description": "Core canonical persistence modules (history, database, migrations, deletion_operations) must not import feature, API, provisioning, transport, or analytics orchestration modules.",
      "source_modules": [
        "canonical-persistence"
      ],
      "target_modules": [
        "analytics-semantic-foundation",
        "analytics-analyzers-metrics",
        "application-services",
        "brain-api-presentation",
        "provisioning-surface",
        "brain-transport"
      ],
      "type": "forbidden",
      "enforcement": {
        "status": "enforced",
        "enforced_by": [
          "tests/test_architecture_contracts.py::test_canonical_persistence_no_upward_contract"
        ]
      }
    },
    {
      "id": "rule-canonical-history-gateway",
      "description": "Only approved gateway modules may depend directly on app.persistence.history; ordinary analytics must use canonical read source.",
      "source_modules": [
        "analytics-analyzers-metrics"
      ],
      "target_modules": [
        "canonical-persistence"
      ],
      "type": "protected",
      "enforcement": {
        "status": "enforced",
        "enforced_by": [
          "tests/test_architecture_contracts.py::test_canonical_history_gateway_contract"
        ]
      }
    },
    {
      "id": "rule-agent-capture-isolation",
      "description": "Agent capture modules must produce observations only and not import transport, outbox publication, or command execution.",
      "source_modules": [
        "agent-capture"
      ],
      "target_modules": [
        "agent-runtime"
      ],
      "type": "forbidden",
      "enforcement": {
        "status": "enforced",
        "enforced_by": [
          "extension/tests/architecture-boundaries.test.mjs"
        ]
      }
    },
    {
      "id": "rule-persistence-factory-no-analytics",
      "description": "Persistence factory must not construct or depend on analytics-facing adapters; recorded under temporary exception until Task 7B.",
      "source_modules": [
        "persistence-factory"
      ],
      "target_modules": [
        "analytics-semantic-foundation"
      ],
      "type": "forbidden",
      "enforcement": {
        "status": "documented",
        "enforced_by": [
          "planned:Task-2-import-linter",
          "planned:Task-7B"
        ]
      }
    },
    {
      "id": "rule-projection-coordination-boundary",
      "description": "Projection activation coordination between canonical revisions and analytics projection publication is an entangled composition seam recorded under current design.",
      "source_modules": [
        "persistence-projection-coordination"
      ],
      "target_modules": [
        "analytics-semantic-foundation"
      ],
      "type": "boundary",
      "enforcement": {
        "status": "documented",
        "enforced_by": [
          "planned:Task-6-contract"
        ]
      }
    },
    {
      "id": "rule-no-service-to-transport",
      "description": "Application services must not discover transport infrastructure, except under declared exception for insights_service until Task 7A.",
      "source_modules": [
        "application-services"
      ],
      "target_modules": [
        "brain-transport"
      ],
      "type": "forbidden",
      "enforcement": {
        "status": "documented",
        "enforced_by": [
          "planned:Task-2-import-linter",
          "planned:Task-7A"
        ]
      }
    },
    {
      "id": "rule-transport-analytics-separation",
      "description": "Transport layer must not construct analytics-facing adapters or directly invoke analytics pipelines.",
      "source_modules": [
        "brain-transport"
      ],
      "target_modules": [
        "analytics-semantic-foundation"
      ],
      "type": "forbidden",
      "enforcement": {
        "status": "documented",
        "enforced_by": [
          "planned:Task-2-import-linter"
        ]
      }
    },
    {
      "id": "rule-bridge-no-canonical-writes",
      "description": "Bridge frontend components and stores consume Brain state and must not act as an ingestion or canonical write proxy.",
      "source_modules": [
        "bridge-presentation",
        "bridge-orchestration"
      ],
      "target_modules": [
        "canonical-persistence"
      ],
      "type": "forbidden",
      "enforcement": {
        "status": "documented",
        "enforced_by": [
