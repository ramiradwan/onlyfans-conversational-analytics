{
  "profile": "urn:bridge-clean:installation-claim-package:v2",
  "governing_adr": "docs/adr/0020-adopt-installation-claim-v2-and-capability-license-delivery.md",
  "messages": {
    "package": "schemas/provisioning/v2/installation-claim-package.schema.json"
  },
  "encoding": {
    "serialization": "compact-json",
    "member_order": [
