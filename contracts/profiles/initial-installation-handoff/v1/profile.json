    "wait-request": "schemas/initial-handoff/v1/wait-request.schema.json",
    "wait-event": "schemas/initial-handoff/v1/wait-event.schema.json",
    "complete-request": "schemas/initial-handoff/v1/complete-request.schema.json",
    "complete-response": "schemas/initial-handoff/v1/complete-response.schema.json",
    "error": "schemas/initial-handoff/v1/error.schema.json",
    "receipt-request": "schemas/initial-handoff/v1/receipt-request.schema.json",
    "receipt-response": "schemas/initial-handoff/v1/receipt-response.schema.json"
