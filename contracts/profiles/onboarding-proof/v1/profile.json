  },
  "governing_adr": "docs/adr/0022-publish-onboarding-continuity-contracts.md",
  "messages": {
    "challenge.request": "schemas/onboarding/v1/proof-challenge-request.schema.json",
    "challenge.response": "schemas/onboarding/v1/proof-challenge-response.schema.json",
    "stream.challenge.request": "schemas/onboarding/v1/stream-proof-challenge-request.schema.json"
  },
  "operations": {
    "hosted-stream": {
      "method": "POST",
