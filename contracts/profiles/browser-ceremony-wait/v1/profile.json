  "first_frame": "current-hint-after-subscription",
  "frame_rule": "emit-only-when-(revision,presentation_state,domain_status)-differs-from-previous-frame",
  "per_frame_recheck": "current-key-and-exact-source-before-each-frame",
  "termination": [
    "after-frame-with-presentation-state-not-active",
    "at-fixed-ceremony-deadline",
    "on-disconnect",
    "on-key-or-source-recheck-failure"
  ],
  "authority": false,
  "creates_or_renews": false,
  "settles_outcome": false,
  "consumer_rule": "every-frame-is-an-invalidation-the-consumer-runs-its-proof-read-reconciliation",
