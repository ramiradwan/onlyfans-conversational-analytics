    "response_media_type": "text/event-stream",
    "event_name": "browser-ceremony",
    "event_id_line": false,
    "data_lines_per_event": 1,
    "keepalive": "comment-line-at-most-every-15-seconds"
  },
  "request": "exact-browser-ceremony-read-scope-with-required-ceremony-id",
  "key_resolution": "same-as-browser-ceremony-read",
