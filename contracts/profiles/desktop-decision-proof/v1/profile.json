{
  "profile": "urn:bridge-clean:desktop-decision-proof:v1",
  "governing_adr": "docs/adr/0030-native-decisions-over-browser-admission.md",
  "domain": "BRIDGE-CLEAN-DESKTOP-DECISION-PROOF-V1\u0000",
  "algorithm": "ES256",
  "signature_encoding": "ieee-p1363-low-s",
  "audience": "urn:bridge-clean:commercial-control-plane:desktop-decision",
  "canonical_request": "RFC8785(request)",
  "request_digest": "SHA-256",
  "field_encoding": "uint32be-length-prefixed",
  "fields": [
    "challenge-raw32",
    "method-utf8",
    "path-utf8",
    "request-digest-raw32",
    "purpose-utf8",
    "RFC7638-key-thumbprint-raw32",
    "audience-utf8"
  ],
  "challenge_ttl_seconds": 60,
  "challenge_single_use": true,
  "challenge_disclosure": "uniform-nonauthorizing-including-unknown-revoked-and-wrong-scope",
  "key_resolution": "exact-original-pending-initial-key-or-active-registered-key",
  "initial_key_after_commit": "same-exact-now-registered-key-for-original-accepted-result-reconciliation-only",
  "cross_domain_detection": "forbidden",
  "purposes": {
    "desktop-decision-read": {
      "method": "POST",
      "path": "/v1/onboarding/desktop-decisions:read"
    },
    "desktop-decision-submit": {
      "method": "POST",
      "path": "/v1/onboarding/desktop-decisions:submit"
    }
  },
  "messages": {
    "proof-challenge-request": "schemas/desktop-decision/v1/proof-challenge-request.schema.json",
    "proof-challenge-response": "schemas/desktop-decision/v1/proof-challenge-response.schema.json"
  }
}
