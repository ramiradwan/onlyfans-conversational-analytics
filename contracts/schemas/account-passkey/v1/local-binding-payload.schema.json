{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/account-passkey/v1/local-binding-payload.schema.json",
  "title": "Signed account passkey local binding claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "iss",
    "aud",
    "purpose",
    "sub",
    "jti",
    "iat",
    "installation_id",
    "installation_key_jkt",
    "credential_id",
    "rp_id",
    "generation",
    "credential_public_key_cose"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:account-passkey-local-binding:v1"
    },
    "iss": {
      "const": "urn:bridge-clean:commercial-control-plane"
    },
    "aud": {
      "const": "urn:bridge-clean:local-brain:account-passkey-local-binding"
    },
    "purpose": {
      "const": "account-passkey-local-binding"
    },
    "sub": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "jti": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "iat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "installation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "installation_key_jkt": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "credential_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1364,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "rp_id": {
      "type": "string",
      "maxLength": 253,
      "format": "hostname",
      "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "credential_public_key_cose": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
