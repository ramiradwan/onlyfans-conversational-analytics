        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "method",
        "attempt_id",
        "confirmation"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:account-passkey-hosted:v1"
        },
        "method": {
          "const": "entra-action"
        },
        "attempt_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
        },
        "confirmation": {
          "const": "remove-account-passkey"
        }
      }
    }
  ]
}
