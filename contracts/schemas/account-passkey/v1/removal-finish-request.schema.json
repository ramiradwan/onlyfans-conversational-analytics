{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/account-passkey/v1/removal-finish-request.schema.json",
  "title": "Browser account passkey removal confirmation v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "method",
        "attempt_id",
        "confirmation",
        "assertion"
      ],
      "properties": {
