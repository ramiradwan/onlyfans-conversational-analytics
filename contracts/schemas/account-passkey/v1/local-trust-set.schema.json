{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/account-passkey/v1/local-trust-set.schema.json",
  "title": "Pinned account passkey local signing trust set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "trust_set_version",
    "sequence",
    "environment",
    "production_usable",
    "keys"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:account-passkey-local-binding:v1"
    },
    "trust_set_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "environment": {
      "enum": [
        "production",
        "qa"
      ]
    },
    "production_usable": {
      "type": "boolean"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kid",
          "purpose",
          "public_jwk",
          "thumbprint",
          "not_before",
          "status"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "minLength": 29,
            "maxLength": 29,
            "pattern": "^bc1\\.(?:pb|pa|pw)\\.[A-Za-z0-9_-]{22}$"
          },
          "purpose": {
            "enum": [
              "account-passkey-local-binding",
              "account-passkey-initial-local-access",
              "account-passkey-local-withdrawal"
            ]
          },
          "public_jwk": {
            "$ref": "../../common/v1/definitions.schema.json#/$defs/publicP256Jwk"
          },
          "thumbprint": {
            "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
          },
          "not_before": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "revoked"
            ]
          },
          "retire_at": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "retired"
                }
              }
            },
            "then": {
              "required": [
                "retire_at"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "production_usable": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "production_usable": {
            "const": false
          }
        }
      }
    }
  ]
}
