{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/account-passkey/v1/hosted-begin-response.schema.json",
  "title": "Browser account passkey authentication options v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "attempt_id",
    "challenge",
    "rp_id",
    "expires_at"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:account-passkey-hosted:v1"
    },
    "attempt_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "challenge": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "rp_id": {
      "type": "string",
      "maxLength": 253,
      "format": "hostname",
      "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "expires_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    }
  }
}
