{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/account-passkey/v1/credential-list-response.schema.json",
  "title": "Browser account passkey credential inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "credentials"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:account-passkey-hosted:v1"
    },
    "credentials": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_ref",
          "display_label"
        ],
        "properties": {
          "credential_ref": {
            "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
          },
          "display_label": {
            "type": "string",
            "pattern": "^Dipsy passkey [A-Z0-9]{6}$",
            "minLength": 20,
            "maxLength": 20
          }
        }
      }
    },
    "next_cursor": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    }
  }
}
