    "cancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "operation_id",
        "ceremony_id",
        "binding",
        "authentication_attempt_id"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:browser-authentication-selection:v1"
        },
        "operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "ceremony_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "binding": {
          "$ref": "../../browser-ceremony/v1/definitions.schema.json#/$defs/binding"
        },
        "authentication_attempt_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
