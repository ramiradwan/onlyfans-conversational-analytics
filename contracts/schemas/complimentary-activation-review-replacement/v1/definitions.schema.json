{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/complimentary-activation-review-replacement/v1/definitions.schema.json",
  "title": "Complimentary activation review replacement definitions v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "source_operation_id",
        "source_continuation_id",
        "source_prepare_digest",
        "scope",
        "activation_operation_id",
        "successor_source_operation_id",
        "successor_activation_operation_id"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:complimentary-activation-review-replacement:v1"
        },
        "source_operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "source_continuation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "source_prepare_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "scope": {
          "$ref": "../../installation-continuation/v2/definitions.schema.json#/$defs/scope"
        },
        "activation_operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "successor_source_operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "successor_activation_operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        }
      }
    }
  }
}
