{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/browser-ceremony-replacement/v1/definitions.schema.json",
  "title": "Browser ceremony replacement definitions v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "predecessor_operation_id",
        "predecessor_ceremony_id",
        "predecessor_binding_digest",
        "predecessor_revision",
        "successor_operation_id",
        "successor_attempt_id"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:browser-ceremony-replacement:v1"
        },
        "predecessor_operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "predecessor_ceremony_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "predecessor_binding_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "predecessor_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "successor_operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "successor_attempt_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
        }
      }
    }
  }
}
