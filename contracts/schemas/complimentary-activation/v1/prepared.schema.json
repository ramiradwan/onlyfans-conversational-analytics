{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/complimentary-activation/v1/prepared.schema.json",
  "title": "Complimentary onboarding activation prepared v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "operation_id",
    "confirmation_reference",
    "state",
    "expires_at",
    "funding",
    "pilot_credit_cost"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:complimentary-onboarding-activation:v1"
    },
    "operation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "confirmation_reference": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "state": {
      "const": "confirmation-required"
    },
    "expires_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "funding": {
      "const": "complimentary-pilot"
    },
    "pilot_credit_cost": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  }
}
