  "title": "Installation authority recovery v1 proof-challenge-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "target"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:installation-authority-recovery-proof:v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "request"
      ],
      "properties": {
        "operation": {
          "enum": [
            "authority-recovery-prepare",
            "authority-recovery-deliver"
          ]
        },
        "request": {
          "$ref": "definitions.schema.json#/$defs/request"
        }
      }
    }
  }
}
