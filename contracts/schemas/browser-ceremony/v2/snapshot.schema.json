{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/browser-ceremony/v2/snapshot.schema.json",
  "title": "Browser ceremony snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ceremony_id",
    "operation_id",
    "attempt_id",
    "binding_digest",
    "expires_at",
    "revision",
    "presentation_state",
    "domain_status"
  ],
  "properties": {
    "ceremony_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "operation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "attempt_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "binding_digest": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
    },
    "expires_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "presentation_state": {
      "enum": [
        "active",
        "retired",
        "expired"
      ]
    },
    "domain_status": {
      "enum": [
        "awaiting-authentication",
        "committed",
        "unavailable",
        "revoked"
      ]
    }
  }
}
