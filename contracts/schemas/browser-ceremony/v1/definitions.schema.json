          ],
          "properties": {
            "mode": {
              "const": "extension-auth-flow"
            },
            "return_uri": {
              "type": "string",
              "minLength": 85,
              "maxLength": 85,
              "pattern": "^https://[a-p]{32}\\.chromiumapp\\.org/browser-ceremony/v1/complete$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
