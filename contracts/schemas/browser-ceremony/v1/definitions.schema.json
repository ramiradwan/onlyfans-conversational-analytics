              "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
            },
            "completion": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "extension_id"
                  ],
                  "properties": {
                    "mode": {
                      "const": "extension-auth-flow"
                    },
                    "extension_id": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 32,
                      "pattern": "^[a-p]{32}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
