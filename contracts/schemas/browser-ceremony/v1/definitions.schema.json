          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "installation_id",
            "installation_key_id",
            "installation_key_jkt",
            "intended_creator_id",
            "attempt_id",
            "completion",
            "source_expires_at",
            "purpose"
