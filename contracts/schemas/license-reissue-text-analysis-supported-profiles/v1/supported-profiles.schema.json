{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/license-reissue-text-analysis-supported-profiles/v1/supported-profiles.schema.json",
  "title": "license-reissue-text-analysis-supported-profiles supported-profiles v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "profiles"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:text-analysis-license-reissue-supported-profiles:v1"
    },
    "profiles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "const": [
        "urn:bridge-clean:text-analysis-license-reissue-authorization:v1",
        "urn:bridge-clean:text-analysis-license-reissue-proof:v1",
        "urn:bridge-clean:text-analysis-license-reissue-supported-profiles:v1",
        "urn:bridge-clean:text-analysis-license-reissue:v1",
        "urn:bridge-clean:text-analysis-license:v1",
        "urn:bridge-clean:text-analysis-release-identity:v1"
      ],
      "items": {
        "type": "string",
        "maxLength": 256,
        "enum": [
          "urn:bridge-clean:text-analysis-license-reissue-authorization:v1",
          "urn:bridge-clean:text-analysis-license-reissue-proof:v1",
          "urn:bridge-clean:text-analysis-license-reissue-supported-profiles:v1",
          "urn:bridge-clean:text-analysis-license-reissue:v1",
          "urn:bridge-clean:text-analysis-license:v1",
          "urn:bridge-clean:text-analysis-release-identity:v1"
        ]
      }
    }
  }
}
