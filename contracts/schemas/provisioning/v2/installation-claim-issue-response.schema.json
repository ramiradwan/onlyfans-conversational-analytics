{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/provisioning/v2/installation-claim-issue-response.schema.json",
  "title": "Installation claim issue response v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "claim_id",
    "claim_secret",
    "challenge",
    "onboarding_transaction_id",
    "organization_id",
    "installation_id",
    "issued_at",
    "expires_at",
    "consume_path",
    "handoff_package",
    "handoff_package_encoded"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:installation-claim:v2"
    },
    "claim_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "claim_secret": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "challenge": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "onboarding_transaction_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "organization_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "installation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "issued_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "consume_path": {
      "type": "string",
      "minLength": 68,
      "maxLength": 68,
      "pattern": "^/v1/installation-claims/[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:consume$"
    },
    "handoff_package": {
      "$ref": "installation-claim-package.schema.json"
    },
    "handoff_package_encoded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1400,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
