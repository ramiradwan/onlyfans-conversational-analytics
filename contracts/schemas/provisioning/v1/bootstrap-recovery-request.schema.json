{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/provisioning/v1/bootstrap-recovery-request.schema.json",
  "title": "Bootstrap recovery request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "proof"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "recovery_request_id",
        "claim_id",
        "onboarding_transaction_id",
        "organization_id",
        "installation_id",
        "installation_key_id",
        "supported_profiles"
      ],
      "properties": {
        "profile": {"const": "urn:bridge-clean:bootstrap-recovery:v1"},
        "recovery_request_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"},
        "claim_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"},
        "onboarding_transaction_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
        "organization_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
        "installation_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
        "installation_key_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/installationKeyId"},
        "supported_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^urn:bridge-clean:[A-Za-z0-9:._~-]+$"}
        }
      }
    },
    "proof": {"$ref": "../../common/v1/definitions.schema.json#/$defs/proof"}
  }
}
