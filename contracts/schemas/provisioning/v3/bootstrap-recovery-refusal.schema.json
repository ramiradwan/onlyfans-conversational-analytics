{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/provisioning/v3/bootstrap-recovery-refusal.schema.json",
  "title": "Bootstrap recovery authority refusal v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "request_id",
    "code",
    "detail"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:error:v1"
    },
    "request_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "code": {
      "const": "forbidden"
    },
    "detail": {
      "enum": [
        "installation_binding_mismatch",
        "bootstrap_authentication_required",
        "bootstrap_authority_withdrawn"
      ]
    }
  }
}
