{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/releases/v1/release-descriptor.schema.json",
  "title": "Generic immutable release descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "product_id",
    "release_version",
    "channel",
    "platform",
    "architecture",
    "artifact",
    "platform_signature",
    "supported_contract_profiles",
    "contract_manifest_sha256",
    "vector_manifest_sha256",
    "trust_set_sha256",
    "published_at"
  ],
  "properties": {
    "profile": {"const": "urn:bridge-clean:release-descriptor:v1"},
    "product_id": {"const": "bridge-clean"},
    "release_version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"},
    "channel": {"enum": ["stable", "preview"]},
    "platform": {"enum": ["windows", "macos", "linux"]},
    "architecture": {"enum": ["x86_64", "arm64"]},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "sha256": {"$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"}
      }
    },
    "platform_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "publisher", "verification_reference"],
      "properties": {
        "scheme": {"enum": ["authenticode", "apple-notarization", "sigstore"]},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 256},
        "verification_reference": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "supported_contract_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^urn:bridge-clean:[A-Za-z0-9:._~-]+$"}
    },
    "contract_manifest_sha256": {"$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"},
    "vector_manifest_sha256": {"$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"},
    "trust_set_sha256": {"$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"},
    "published_at": {"$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"}
  }
}
