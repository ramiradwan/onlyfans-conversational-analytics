    },
    "operation_id": {
      "$ref": "https://contracts.bridge-clean.invalid/schemas/common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "binding": {
      "$ref": "https://contracts.bridge-clean.invalid/schemas/license-reissue-text-analysis/v1/definitions.schema.json#/$defs/binding"
    },
    "state": {
