{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/license-reissue-text-analysis/v1/prepare-response.schema.json",
  "title": "license-reissue-text-analysis prepare-response v1",
  "type": "object",
