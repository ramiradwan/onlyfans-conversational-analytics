{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/installation-continuation/v2/snapshot.schema.json",
  "title": "Installation setup continuation snapshot v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "continuation_id",
    "epoch",
    "revision",
    "committed_at",
    "expires_at",
    "state"
  ],
  "properties": {
    "continuation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "epoch": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "committed_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "state": {
      "enum": [
        "awaiting-owner",
        "awaiting-approval",
        "approved",
        "authentication-required",
        "expired",
        "revoked"
      ]
    }
  }
}
