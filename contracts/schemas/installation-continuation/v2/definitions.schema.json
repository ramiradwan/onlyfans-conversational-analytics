{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/installation-continuation/v2/definitions.schema.json",
  "title": "Installation setup continuation definitions v2",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "installation_id",
        "installation_key_id",
        "source_onboarding_transaction_id",
        "creator_account_id",
        "association_request_id"
      ],
      "properties": {
        "organization_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
        },
        "installation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
        },
        "installation_key_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/installationKeyId"
        },
        "source_onboarding_transaction_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
        },
        "creator_account_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
        },
        "association_request_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "revision"
      ],
      "properties": {
        "epoch": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge",
        "signature"
      ],
      "properties": {
        "challenge": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
        },
        "signature": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url64"
        }
      }
    }
  }
}
