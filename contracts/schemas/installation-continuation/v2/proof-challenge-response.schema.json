{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/installation-continuation/v2/proof-challenge-response.schema.json",
  "title": "Installation setup continuation proof-challenge-response v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "challenge",
    "request_digest",
    "expires_at"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:installation-setup-continuation-proof:v2"
    },
    "challenge": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "request_digest": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
    },
    "expires_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    }
  }
}
