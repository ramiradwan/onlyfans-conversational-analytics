{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/license-reissue-text-analysis-proof/v2/definitions.schema.json",
  "title": "license-reissue-text-analysis-proof definitions v2",
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "challenge",
        "signature"
      ],
      "properties": {
        "challenge_id": {
          "$ref": "https://contracts.bridge-clean.invalid/schemas/common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "challenge": {
          "$ref": "https://contracts.bridge-clean.invalid/schemas/common/v1/definitions.schema.json#/$defs/base64url32"
        },
        "signature": {
          "$ref": "https://contracts.bridge-clean.invalid/schemas/common/v1/definitions.schema.json#/$defs/base64url64"
        }
      }
    }
  }
}
