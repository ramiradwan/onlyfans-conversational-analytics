{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/commercial/v1/grant-profile.schema.json",
  "title": "ADR 0010 signed grant payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "grant_type",
    "iss",
    "aud",
    "sub",
    "jti",
    "iat",
    "nbf",
    "exp",
    "organization_id",
    "installation_id",
    "installation_key_id",
    "installation_key_jkt"
  ],
  "properties": {
    "profile": {"const": "urn:bridge-clean:grant-profile:v1"},
    "grant_type": {
      "enum": [
        "installation_grant",
        "creator_account_binding",
        "membership_snapshot",
        "license_entitlement"
      ]
    },
    "iss": {"const": "urn:bridge-clean:commercial-control-plane"},
    "aud": {"type": "string", "minLength": 1, "maxLength": 64},
    "sub": {"type": "string", "minLength": 1, "maxLength": 4096},
    "jti": {"$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"},
    "iat": {"type": "integer"},
    "nbf": {"type": "integer"},
    "exp": {"type": "integer"},
    "organization_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
    "installation_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
    "installation_key_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/installationKeyId"},
    "installation_key_jkt": {"$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"},
    "approval_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"},
    "approval_revision": {"type": "integer", "minimum": 1},
    "creator_account_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
    "membership_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
    "ciam_issuer": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^https://[^#]+$"
    },
    "ciam_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["owner", "administrator", "creator_operator", "delegated_installer"]}
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "commercial:manage",
          "creator-binding:approve",
          "creator-binding:revoke",
          "installation-claim:issue",
          "installation:provision",
          "membership:manage",
          "organization:manage",
          "provisioning:milestone",
          "runtime:existing-data",
          "runtime:licensed-processing"
        ]
      }
    },
    "allowed_creator_account_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"}
    },
    "entitlement_id": {"$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"},
    "product_id": {"const": "bridge-clean"},
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["agent-capture", "analytics-processing", "command-execution", "ingestion"]
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "grant_type": {"const": "installation_grant"},
            "aud": {"const": "urn:bridge-clean:local-brain:installation"},
            "sub": {"pattern": "^installation:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"}
          },
          "not": {
            "anyOf": [
              {"required": ["approval_id"]},
              {"required": ["approval_revision"]},
              {"required": ["creator_account_id"]},
              {"required": ["membership_id"]},
              {"required": ["ciam_issuer"]},
              {"required": ["ciam_subject"]},
              {"required": ["roles"]},
              {"required": ["scopes"]},
              {"required": ["allowed_creator_account_ids"]},
              {"required": ["entitlement_id"]},
              {"required": ["product_id"]},
              {"required": ["features"]}
            ]
          }
        },
        {
          "required": ["approval_id", "approval_revision", "creator_account_id"],
          "properties": {
            "grant_type": {"const": "creator_account_binding"},
            "aud": {"const": "urn:bridge-clean:local-brain:creator-binding"},
            "sub": {"pattern": "^installation:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}:creator:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"}
          },
          "not": {
            "anyOf": [
              {"required": ["membership_id"]},
              {"required": ["ciam_issuer"]},
              {"required": ["ciam_subject"]},
              {"required": ["roles"]},
              {"required": ["scopes"]},
              {"required": ["allowed_creator_account_ids"]},
              {"required": ["entitlement_id"]},
              {"required": ["product_id"]},
              {"required": ["features"]}
            ]
          }
        },
        {
          "required": [
            "membership_id",
            "ciam_issuer",
            "ciam_subject",
            "roles",
            "scopes",
            "allowed_creator_account_ids"
          ],
          "properties": {
            "grant_type": {"const": "membership_snapshot"},
            "aud": {"const": "urn:bridge-clean:local-brain:membership"},
            "sub": {"pattern": "^principal:[A-Za-z0-9_-]+$"}
          },
          "not": {
            "anyOf": [
              {"required": ["approval_id"]},
              {"required": ["approval_revision"]},
              {"required": ["creator_account_id"]},
              {"required": ["entitlement_id"]},
              {"required": ["product_id"]},
              {"required": ["features"]}
            ]
          }
        },
        {
          "required": ["entitlement_id", "product_id", "features"],
          "properties": {
            "grant_type": {"const": "license_entitlement"},
            "aud": {"const": "urn:bridge-clean:local-brain:license"},
            "sub": {"pattern": "^organization:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}:installation:[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"}
          },
          "not": {
            "anyOf": [
              {"required": ["approval_id"]},
              {"required": ["approval_revision"]},
              {"required": ["creator_account_id"]},
              {"required": ["membership_id"]},
              {"required": ["ciam_issuer"]},
              {"required": ["ciam_subject"]},
              {"required": ["roles"]},
              {"required": ["scopes"]},
              {"required": ["allowed_creator_account_ids"]}
            ]
          }
        }
      ]
    }
  ]
}
