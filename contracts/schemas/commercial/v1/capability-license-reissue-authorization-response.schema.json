{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/commercial/v1/capability-license-reissue-authorization-response.schema.json",
  "title": "Capability license replacement reissue customer authorization response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "reissue_authorization_id",
    "authorization_state",
    "authorized_at",
    "organization_id",
    "prior_license_id",
    "prior_issuance_id",
    "replacement_installation_id",
    "reissue_reason",
    "customer_step_up_ref",
    "decision_audit_ref",
    "handoff_package",
    "handoff_package_encoded"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:capability-license-reissue-authorization:v1"
    },
    "reissue_authorization_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "authorization_state": {
      "const": "pending"
    },
    "authorized_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "organization_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "prior_license_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "prior_issuance_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "replacement_installation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "reissue_reason": {
      "enum": [
        "replacement-installation",
        "lost-or-destroyed-installation",
        "inaccessible-original-hardware"
      ]
    },
    "customer_step_up_ref": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId",
      "description": "Audit reference to the server-held customer step-up evidence consumed when this authorization was committed; not a bearer credential."
    },
    "decision_audit_ref": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "handoff_package": {
      "$ref": "capability-license-reissue-package.schema.json"
    },
    "handoff_package_encoded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1400,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
