{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/commercial/v1/capability-license-redemption-proof-challenge-response.schema.json",
  "title": "CapabilityLicense opaque redemption proof challenge response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "continuation",
    "redemption_id",
    "organization_id",
    "installation_id",
    "purpose",
    "proof_challenge_id",
    "challenge",
    "audience",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:capability-license-redemption-proof:v1"
    },
    "continuation": {
      "type": "string",
      "minLength": 48,
      "maxLength": 48,
      "pattern": "^clr1\\.[A-Za-z0-9_-]{43}$"
    },
    "redemption_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "organization_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "installation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "purpose": {
      "const": "capability-license-redeem"
    },
    "proof_challenge_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
    },
    "challenge": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
    },
    "audience": {
      "const": "urn:bridge-clean:commercial-control-plane:capability-license-redemption"
    },
    "issued_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/timestamp"
    }
  }
}
