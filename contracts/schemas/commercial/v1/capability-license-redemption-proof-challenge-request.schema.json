{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/commercial/v1/capability-license-redemption-proof-challenge-request.schema.json",
  "title": "CapabilityLicense opaque redemption proof challenge request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "continuation",
    "organization_id",
    "installation_id"
  ],
  "properties": {
    "profile": {
      "const": "urn:bridge-clean:capability-license-redemption-proof:v1"
    },
    "continuation": {
      "type": "string",
      "minLength": 48,
      "maxLength": 48,
      "pattern": "^clr1\\.[A-Za-z0-9_-]{43}$"
    },
    "organization_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    },
    "installation_id": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
    }
  }
}
