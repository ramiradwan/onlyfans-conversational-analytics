{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/commercial/v1/capability-license-reissue-request.schema.json",
  "title": "Capability license replacement-installation reissue finalization request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "proof"
  ],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "reissue_authorization_id",
        "organization_id",
        "prior_license_id",
        "prior_issuance_id",
        "replacement_installation_id",
        "reissue_reason"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:capability-license-reissue:v1"
        },
        "reissue_authorization_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7",
          "description": "Exact durable pending reissue authorization previously committed by the authenticated customer flow. This identifier is not a bearer credential."
        },
        "organization_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
        },
        "prior_license_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "prior_issuance_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "replacement_installation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
        },
        "reissue_reason": {
          "enum": [
            "replacement-installation",
            "lost-or-destroyed-installation",
            "inaccessible-original-hardware"
          ]
        }
      }
    },
    "proof": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/proof"
    }
  }
}
