        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        "decision_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "authenticated_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "quote_id",
        "quote_digest",
        "permit_id",
        "issuance_id",
        "capability_permit",
        "committed_at"
      ],
      "properties": {
        "operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "quote_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "quote_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "permit_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "issuance_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "capability_permit": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/compactJws"
        },
        "committed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      }
