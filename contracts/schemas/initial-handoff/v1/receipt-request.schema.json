{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/initial-handoff/v1/receipt-request.schema.json",
  "title": "Initial installation handoff receipt request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "proof"
  ],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "operation_id",
        "installation_id",
        "installation_key_id"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:initial-installation-handoff:v1"
        },
        "operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "installation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/crossPlaneId"
        },
        "installation_key_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/installationKeyId"
        }
      }
    },
    "proof": {
      "$ref": "../../common/v1/definitions.schema.json#/$defs/proof"
    }
  }
}
