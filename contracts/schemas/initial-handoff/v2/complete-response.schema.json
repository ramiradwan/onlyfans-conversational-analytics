{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/initial-handoff/v2/complete-response.schema.json",
  "title": "Initial installation handoff complete-response v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "bootstrap"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:initial-installation-handoff:v2"
        },
        "status": {
          "const": "completed"
        },
        "bootstrap": {
          "$ref": "../../provisioning/v2/installation-claim-consume-response.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "receipt"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:initial-installation-handoff:v2"
        },
        "status": {
          "const": "recovery-required"
        },
        "receipt": {
          "$ref": "definitions.schema.json#/$defs/receipt"
        }
      }
    }
  ]
}
