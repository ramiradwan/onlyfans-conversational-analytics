{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/desktop-decision/v1/read-response.schema.json",
  "title": "Desktop decision read-response v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "operation_id",
        "ceremony_id",
        "binding_digest",
        "state"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:desktop-decision:v1"
        },
        "operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "ceremony_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "binding_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "state": {
          "enum": [
            "awaiting-authentication",
            "accepted",
            "unavailable"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "operation_id",
        "ceremony_id",
        "binding_digest",
        "state",
        "decision_reference",
        "decision_digest",
        "decision"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:desktop-decision:v1"
        },
        "operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "ceremony_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "binding_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "state": {
          "const": "confirmation-required"
        },
        "decision_reference": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
        },
        "decision_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "decision": {
          "$ref": "decision.schema.json"
        }
      }
    }
  ]
}
