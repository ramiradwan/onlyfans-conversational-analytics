{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bridge-clean.invalid/schemas/desktop-decision/v1/definitions.schema.json",
  "title": "Desktop decision definitions v1",
  "$defs": {
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "operation_id",
        "ceremony_id",
        "binding"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:desktop-decision:v1"
        },
        "operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "ceremony_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "binding": {
          "$ref": "../../browser-ceremony/v1/definitions.schema.json#/$defs/binding"
        }
      }
    },
    "submitRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "operation_id",
        "ceremony_id",
        "binding",
        "decision_reference",
        "decision_digest",
        "consent"
      ],
      "properties": {
        "profile": {
          "const": "urn:bridge-clean:desktop-decision:v1"
        },
        "operation_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "ceremony_id": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/uuidV7"
        },
        "binding": {
          "$ref": "../../browser-ceremony/v1/definitions.schema.json#/$defs/binding"
        },
        "decision_reference": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
        },
        "decision_digest": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/sha256Hex"
        },
        "consent": {
          "enum": [
            "connect-account",
            "activate-complimentary"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "consent": {
                "const": "connect-account"
              }
            }
          },
          "then": {
            "properties": {
              "binding": {
                "properties": {
                  "purpose": {
                    "const": "connect-account"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "consent": {
                "const": "activate-complimentary"
              }
            }
          },
          "then": {
            "properties": {
              "binding": {
                "properties": {
                  "purpose": {
                    "const": "activate-complimentary"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge",
        "signature"
      ],
      "properties": {
        "challenge": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url32"
        },
        "signature": {
          "$ref": "../../common/v1/definitions.schema.json#/$defs/base64url64"
        }
      }
    }
  }
}
