{
  "name": "onlyfans-analytics-frontend",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "generate:theme": "ts-node --esm src/theme/generate-theme.ts",
    "sync:static-tokens": "ts-node --esm src/theme/generate-theme.ts --static-surfaces",
    "watch:tokens": "chokidar 'src/theme/tokens.json' -c 'npm run generate:theme'",
    "dev": "npm run generate:theme && vite",
    "preview": "vite preview",
    "test": "vitest run",
    "build": "npm run generate:theme && npm run typecheck && npm run lint && vite build && npm run verify:story-isolation",
    "verify:story-isolation": "node ./scripts/verify-story-isolation.js",
    "sync:rest": "openapi-typescript http://localhost:8000/openapi.json --output src/types/backend.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:design-sync": "tsc --noEmit --project .design-sync/tsconfig.json",
    "lint": "eslint src tests .design-sync --max-warnings=0 --cache",
    "prepare": "cd .. && husky .husky",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs src/protocol src/store src/services",
    "check:unused": "knip"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "tests/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    ".design-sync/**/*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/system": "9.4.0",
    "dompurify": "^3.4.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc/plugin-emotion": "^14.19.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "axe-core": "4.13.0",
    "chokidar-cli": "^3.0.0",
    "colorjs.io": "0.7.1",
    "dependency-cruiser": "18.3.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "openapi-typescript": "^7.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
